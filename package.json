{
  "name": "thread-mark",
  "version": "0.3.0",
  "description": "Turn a Slack thread into clean, LLM-ready markdown",
  "license": "MIT",
  "author": "Sanket Upreti",
  "type": "module",
  "bin": {
    "thread-mark": "./dist/cli.js"
  },
  "scripts": {
    "build": "bun run build:server && bun run build:client && bun run build:extension",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "tsc -p tsconfig.client.json",
    "build:extension": "bun scripts/build-extension.mjs",
    "dev": "tsc -p tsconfig.client.json && tsx src/web/server.ts",
    "web": "tsc -p tsconfig.client.json && tsx src/web/server.ts",
    "cli": "tsx src/cli.ts",
    "mcp": "tsx src/mcp/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.tools.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@slack/web-api": "^7.8.0",
    "clipboardy": "^4.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
