# Copy this file to .env and paste your token. Nothing else is needed —
# the CLI, MCP server, and web UI all pick it up automatically.
#
# It must be a USER token (xoxp-), not a bot token: bot tokens can only read
# channels the bot was invited to.
#
# Get one at https://api.slack.com/apps -> Create New App -> From scratch,
# then OAuth & Permissions -> User Token Scopes:
#   channels:history  groups:history  im:history  mpim:history  users:read  files:read
# Install to your workspace and copy the User OAuth Token.

SLACK_USER_TOKEN=xoxp-your-token-here
